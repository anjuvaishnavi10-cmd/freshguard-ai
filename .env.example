# ==============================================================================
# FreshGuard AI — Environment Configuration Template
# GDGoC HITAM Agentic AI Hackathon
# ==============================================================================
#
# INSTRUCTIONS:
# 1. Copy this file to '.env':
#      cp .env.example .env   (Linux/macOS)
#      copy .env.example .env (Windows Command Prompt)
#      Copy-Item .env.example .env (PowerShell)
# 2. Fill in your credentials below.
# 3. NEVER commit your actual '.env' file or credentials to Git.
#

# Server Port (Default: 8080)
PORT=8080

# Google OAuth 2.0 Configuration (Optional)
# If not configured, FreshGuard AI automatically activates built-in Sandbox Demo Mode
# with pre-configured demo customer profiles for hackathon judging and evaluation.
#
# To use real Google Sign-In:
# 1. Go to Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (Application type: "Web application")
# 3. Add to "Authorized JavaScript origins":
#      http://localhost:8080
# 4. Add to "Authorized redirect URIs":
#      http://localhost:8080/api/auth/google/callback
# 5. Paste your Client ID and Client Secret below:
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
